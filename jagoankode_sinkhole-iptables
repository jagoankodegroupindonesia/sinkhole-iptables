#!/bin/bash
#
# jagoankode_sinkhole-iptables
# CLI untuk kelola pemblokiran domain via iptables string-matching, bersumber dari raw GitHub repo.
# Repository: https://github.com/jagoankodegroupindonesia/sinkhole-iptables
#
# Usage:
#   jagoankode_sinkhole-iptables install [raw_github_url]
#   jagoankode_sinkhole-iptables update
#   jagoankode_sinkhole-iptables status
#   jagoankode_sinkhole-iptables list
#   jagoankode_sinkhole-iptables uninstall
#

set -e

PROG_NAME="jagoankode_sinkhole-iptables"
CHAIN_NAME="JAGOANKODE_SINKHOLE"
CONF_DIR="/etc/jagoankode-sinkhole"
CONFIG_FILE="$CONF_DIR/config"
DOMAIN_CACHE="$CONF_DIR/domains.txt"
LOG_FILE="/var/log/jagoankode-sinkhole.log"
SELF_PATH="/usr/local/bin/$PROG_NAME"
CRON_FILE="/etc/cron.d/jagoankode-sinkhole"
DEFAULT_RAW_URL="https://raw.githubusercontent.com/jagoankodegroupindonesia/sinkhole-iptables/main/blockinglist.txt"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

need_root() {
    if [ "$EUID" -ne 0 ]; then
        echo "[!] Perintah ini harus dijalankan sebagai root (gunakan sudo)."
        exit 1
    fi
}

check_dependencies() {
    # Pastikan iptables dan curl tersedia
    for cmd in iptables curl; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            echo "[!] Error: '$cmd' tidak ditemukan. Harap install terlebih dahulu."
            exit 1
        fi
    done

    # Coba muat modul xt_string jika belum aktif
    if command -v modprobe >/dev/null 2>&1; then
        modprobe xt_string >/dev/null 2>&1 || true
    fi
}

usage() {
    cat <<EOF
========================================================================
 $PROG_NAME - Domain Sinkhole / Blocker via iptables
 (c) Jagoankode Group Indonesia
========================================================================

Pemakaian:
  $PROG_NAME install [raw_github_url]  Setup awal (simpan config, sync pertama, pasang cron harian & hook CSF)
  $PROG_NAME update                    Tarik daftar domain terbaru dari GitHub & perbarui aturan iptables
  $PROG_NAME status                    Tampilkan status rule iptables, jumlah domain, dan waktu update terakhir
  $PROG_NAME list                      Tampilkan daftar domain yang sedang aktif diblokir di server
  $PROG_NAME uninstall                 Bersihkan seluruh chain iptables, cron, hook CSF, dan file konfigurasi

Contoh:
  sudo $PROG_NAME install
  sudo $PROG_NAME install https://raw.githubusercontent.com/jagoankodegroupindonesia/sinkhole-iptables/main/blockinglist.txt
  sudo $PROG_NAME update
  $PROG_NAME status
EOF
}

cmd_install() {
    need_root
    check_dependencies

    local raw_url="${1:-$DEFAULT_RAW_URL}"

    mkdir -p "$CONF_DIR"
    cat > "$CONFIG_FILE" <<EOF
RAW_URL="$raw_url"
CHAIN_NAME="$CHAIN_NAME"
EOF
    echo "[+] File konfigurasi disimpan di $CONFIG_FILE"
    echo "    URL Sumber: $raw_url"

    # Salin diri sendiri ke /usr/local/bin jika belum ada di sana
    if [ "$(readlink -f "$0" 2>/dev/null || echo "$0")" != "$SELF_PATH" ]; then
        cp "$0" "$SELF_PATH"
        chmod +x "$SELF_PATH"
        echo "[+] Command diinstal ke $SELF_PATH"
    fi

    # Lakukan sinkronisasi pertama kali
    echo "[*] Melakukan sinkronisasi domain pertama kali..."
    cmd_update

    # Pasang Cron Job Harian (Setiap hari jam 03:00 pagi)
    cat > "$CRON_FILE" <<EOF
# Auto-sync domain sinkhole iptables dari GitHub
0 3 * * * root $SELF_PATH update >> $LOG_FILE 2>&1
EOF
    chmod 644 "$CRON_FILE"
    echo "[+] Cron job otomatis dipasang di $CRON_FILE (setiap hari pk 03:00)"

    # Pasang hook ke CSF Firewall jika server menggunakan CSF (ConfigServer Security & Firewall)
    if [ -f /etc/csf/csfpost.sh ]; then
        if ! grep -qF "$SELF_PATH" /etc/csf/csfpost.sh; then
            {
                echo ""
                echo "# Re-apply jagoankode sinkhole chain setelah CSF restart/reload"
                echo "$SELF_PATH update >> $LOG_FILE 2>&1"
            } >> /etc/csf/csfpost.sh
            chmod +x /etc/csf/csfpost.sh
            echo "[+] Hook CSF Firewall ditambahkan ke /etc/csf/csfpost.sh"
        fi
    fi

    echo ""
    echo "[✔] Instalasi selesai dan aktif! Cek status dengan: $PROG_NAME status"
}

cmd_update() {
    need_root
    check_dependencies

    mkdir -p "$CONF_DIR"
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "[!] File konfigurasi belum ada. Jalankan '$PROG_NAME install [raw_url]' terlebih dahulu."
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"

    local tmp_file
    tmp_file=$(mktemp)

    log "[*] Mengunduh daftar domain blokir dari: $RAW_URL"

    if ! curl -fsSL --retry 3 --retry-delay 3 "$RAW_URL" -o "$tmp_file"; then
        log "[!] GAGAL mengunduh dari $RAW_URL - Aturan iptables sebelumnya tetap dipertahankan."
        rm -f "$tmp_file"
        exit 1
    fi

    if [ ! -s "$tmp_file" ]; then
        log "[!] File domain list kosong / tidak dapat dibaca. Update dibatalkan."
        rm -f "$tmp_file"
        exit 1
    fi

    # Buat custom iptables chain jika belum ada, lalu flush chain tersebut
    iptables -N "$CHAIN_NAME" 2>/dev/null || true
    iptables -F "$CHAIN_NAME"

    # Pastikan tabel OUTPUT dan FORWARD mengarah (jump) ke chain kita
    iptables -C OUTPUT -j "$CHAIN_NAME" 2>/dev/null || iptables -I OUTPUT 1 -j "$CHAIN_NAME"
    iptables -C FORWARD -j "$CHAIN_NAME" 2>/dev/null || iptables -I FORWARD 1 -j "$CHAIN_NAME"

    local count=0
    > "$DOMAIN_CACHE"

    while IFS= read -r line || [ -n "$line" ]; do
        # Bersihkan whitespace, carriage return (\r), dan baris komentar
        domain=$(echo "$line" | tr -d '\r\n\t' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        [ -z "$domain" ] && continue
        [[ "$domain" =~ ^# ]] && continue

        # Jika user menulis wildcard seperti *.domain.com atau .domain.com, hapus prefix tersebut
        domain=$(echo "$domain" | sed -e 's/^\*\.//' -e 's/^\.//')

        # Tambahkan rule iptables string match untuk TCP & UDP (DNS & Web/Raw TCP traffic)
        iptables -A "$CHAIN_NAME" -p tcp -m string --string "$domain" --algo bm -j DROP
        iptables -A "$CHAIN_NAME" -p udp -m string --string "$domain" --algo bm -j DROP
        echo "$domain" >> "$DOMAIN_CACHE"
        count=$((count + 1))
    done < "$tmp_file"


    rm -f "$tmp_file"
    date '+%Y-%m-%d %H:%M:%S' > "$CONF_DIR/last_update"
    log "[✔] Sinkronisasi berhasil. Total $count domain aktif diblokir via iptables chain '$CHAIN_NAME'."

    # Simpan status iptables jika tersedia utilitas persistent
    if command -v netfilter-persistent >/dev/null 2>&1; then
        netfilter-persistent save >> "$LOG_FILE" 2>&1 || true
    elif [ -d /etc/iptables ] && command -v iptables-save >/dev/null 2>&1; then
        iptables-save > /etc/iptables/rules.v4 2>/dev/null || true
    fi
}

cmd_status() {
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "[!] Belum terinstal. Silakan jalankan: sudo $PROG_NAME install"
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"

    echo "================================================="
    echo "  Status $PROG_NAME"
    echo "================================================="
    echo "URL Sumber Blocklist : $RAW_URL"
    
    if iptables -L "$CHAIN_NAME" -n >/dev/null 2>&1; then
        local rule_count
        rule_count=$(iptables -L "$CHAIN_NAME" -n | tail -n +3 | wc -l | tr -d ' ')
        echo "Status Chain         : AKTIF ($CHAIN_NAME - $rule_count rules)"
    else
        echo "Status Chain         : TIDAK AKTIF / BELUM DIBUAT"
    fi

    if [ -f "$DOMAIN_CACHE" ]; then
        echo "Total Domain Terdaftar: $(wc -l < "$DOMAIN_CACHE" | tr -d ' ') domain"
    fi

    if [ -f "$CONF_DIR/last_update" ]; then
        echo "Update Terakhir      : $(cat "$CONF_DIR/last_update")"
    fi

    if [ -f "$CRON_FILE" ]; then
        echo "Otomatisasi Cron     : Terpasang ($CRON_FILE)"
    else
        echo "Otomatisasi Cron     : Tidak Terpasang"
    fi

    if [ -f /etc/csf/csfpost.sh ] && grep -qF "$SELF_PATH" /etc/csf/csfpost.sh; then
        echo "Integrasi CSF        : Terpasang di /etc/csf/csfpost.sh"
    fi
    echo "================================================="
}

cmd_list() {
    if [ ! -f "$DOMAIN_CACHE" ]; then
        echo "[!] Belum ada cache domain. Silakan jalankan: sudo $PROG_NAME update"
        exit 1
    fi
    echo "=== Daftar Domain Terblokir Saat Ini ==="
    cat -n "$DOMAIN_CACHE"
}

cmd_uninstall() {
    need_root

    echo "[*] Menghapus rule dan chain iptables..."
    if iptables -L "$CHAIN_NAME" -n >/dev/null 2>&1; then
        iptables -D OUTPUT -j "$CHAIN_NAME" 2>/dev/null || true
        iptables -D FORWARD -j "$CHAIN_NAME" 2>/dev/null || true
        iptables -F "$CHAIN_NAME" 2>/dev/null || true
        iptables -X "$CHAIN_NAME" 2>/dev/null || true
        echo "[+] Chain $CHAIN_NAME berhasil dihapus dari iptables."
    fi

    echo "[*] Membersihkan cron job dan konfigurasi..."
    rm -f "$CRON_FILE"
    rm -rf "$CONF_DIR"

    if [ -f /etc/csf/csfpost.sh ]; then
        sed -i "\|$SELF_PATH|d" /etc/csf/csfpost.sh 2>/dev/null || true
        sed -i "/Re-apply jagoankode sinkhole/d" /etc/csf/csfpost.sh 2>/dev/null || true
        echo "[+] Hook pada CSF Firewall dibersihkan."
    fi

    if [ -f "$SELF_PATH" ]; then
        rm -f "$SELF_PATH"
        echo "[+] Binary $SELF_PATH dihapus."
    fi

    echo "[✔] Uninstall selesai. Seluruh konfigurasi dan rule telah dihapus."
}

case "$1" in
    install)   shift; cmd_install "$@" ;;
    update)    cmd_update ;;
    status)    cmd_status ;;
    list)      cmd_list ;;
    uninstall) cmd_uninstall ;;
    *)         usage ;;
esac

